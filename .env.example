# ==============================================================================
# AutoHarvest AWS Bedrock & Precision Agronomy Environment Configuration
# ==============================================================================
# To connect AgriCopilot & CropVision directly to live AWS Bedrock Foundation Models
# (Claude 3.5 Sonnet, Claude 3 Haiku, Amazon Nova Pro), fill in your AWS credentials below:

AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_optional_session_token_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Preferred Foundation Model Identifier:
# Options:
#   - us.anthropic.claude-3-5-sonnet-20241022-v2:0 (Claude 3.5 Sonnet v2)
#   - anthropic.claude-3-5-sonnet-20241022-v2:0
#   - anthropic.claude-3-haiku-20240307-v1:0
#   - amazon.nova-pro-v1:0
#   - amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
